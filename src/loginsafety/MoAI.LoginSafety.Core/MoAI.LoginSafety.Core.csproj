<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RootNamespace>MoAI.LoginSafety</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Hangfire.Core" />
		<PackageReference Include="SmartFormat.NET" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\database\MoAI.Database.Shared\MoAI.Database.Shared.csproj" />
		<ProjectReference Include="..\..\message\MoAI.Message.Shared\MoAI.Message.Shared.csproj" />
		<ProjectReference Include="..\..\notification\MoAI.Notification.Shared\MoAI.Notification.Shared.csproj" />
		<ProjectReference Include="..\..\settings\MoAI.Settings.Shared\MoAI.Settings.Shared.csproj" />
		<ProjectReference Include="..\MoAI.LoginSafety.Api\MoAI.LoginSafety.Api.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Handlers\" />
		<Folder Include="Services\" />
	</ItemGroup>

	<ItemGroup>
		<!-- IP 归属地离线库（ip2region v3 xdb，约 11MB）：作为嵌入资源随程序集分发，
		     不落 configs（那里是挂载/配置目录），不需要 Dockerfile COPY 或部署机投文件。
		     Exists 条件保护：稀疏检出里没有该文件时不阻断构建，运行期自动降级。 -->
		<EmbeddedResource Include="Resources\ip2region.xdb"
		                  LogicalName="MoAI.LoginSafety.Resources.ip2region.xdb"
		                  Condition="Exists('Resources\ip2region.xdb')" />
	</ItemGroup>

</Project>
