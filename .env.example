# ============================================
# MoAI Docker Compose 环境变量配置
# 复制为 .env 后按需修改：cp .env.example .env
#
# 本文件是 Compose 部署的**唯一配置来源**：
# deploy-compose.sh 会据此生成 configs/system.json（挂载进容器）。
# 参考模板见 configs/system.example.json。
# ============================================

# ============================================
# MoAI 服务
# ============================================
# 应用镜像（默认 Docker Hub；本地源码构建时 compose 会使用 build 结果）
MOAI_IMAGE=whuanle/moai:latest
MOAI_PORT=8080
TZ=Asia/Shanghai

# MoAI 对外访问主机（IP 或域名）。它会被注入 system.json 的
# Server/WebUI 与 Storage.Endpoint（预签名上传地址须浏览器可达），
# 因此必须填「浏览器访问 MoAI 用的地址」。
# 留空时 deploy-compose.sh 会自动探测本机 IP；公网域名请手动填写。
MOAI_HOST=

# 应用配置文件在宿主机的位置（挂载到容器 /app/configs/system.json）。
# deploy-compose.sh 会按本文件的环境变量生成该配置；可填相对仓库根或绝对路径。
MOAI_CONFIG_FILE=./configs/system.json

# ============================================
# MoAI 应用配置（deploy-compose.sh 据此生成 ${MOAI_CONFIG_FILE}）
# ============================================
# AES 加密密钥（生产务必改为随机串）
MOAI_AES_KEY=please-change-this-aes-key

# 对象存储对外访问地址（自定义域名 / 外部 OSS 时填）。
# 留空则用 http://${MOAI_HOST}:${RUSTFS_PORT}。
# 该地址会写入预签名 URL，必须同时被容器与浏览器可达。
S3_ENDPOINT=

# OpenSandbox 沙箱存活时间与续期阈值（秒）
OPENSANDBOX_TIMEOUT_SECONDS=900
OPENSANDBOX_RENEW_THRESHOLD_SECONDS=300

# OpenTelemetry（可选，留空禁用）
OTLP_TRACE=
OTLP_METRICS=
OTLP_PROTOCOL=0

# ============================================
# PostgreSQL 数据库（pgvector）
# 以下值会写入生成的 system.json 的 MoAI:Database
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=moai123456
POSTGRES_DB=moai
POSTGRES_PORT=5432

# ============================================
# Redis（写入生成的 system.json 的 MoAI:Redis）
# ============================================
REDIS_PORT=6379

# ============================================
# RabbitMQ（写入生成的 system.json 的 MoAI:RabbitMQ）
# ============================================
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ============================================
# RustFS 对象存储（S3 兼容，替代 MinIO）
# S3_* 会写入生成的 system.json 的 MoAI:Storage
# ============================================
RUSTFS_IMAGE=rustfs/rustfs:latest
RUSTFS_INIT_IMAGE=amazon/aws-cli:latest
S3_ACCESS_KEY_ID=moaiadmin
S3_ACCESS_KEY_SECRET=moaiadmin123
S3_BUCKET=moai
S3_REGION=us-east-1
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# ============================================
# OpenSandbox 沙箱服务
# ============================================
# 生命周期服务镜像（官方镜像；受限网络可用阿里云镜像
# sandbox-registry.cn-zhangjiakou.cr.aliyuncs.com/opensandbox/server:release-1.1.0）
OPENSANDBOX_SERVER_IMAGE=opensandbox/server:latest
OPENSANDBOX_PORT=18123
# sandbox.toml 未配置 api_key 时必须为 YES（仅内网可信环境）
OPENSANDBOX_INSECURE_SERVER=YES
# 沙箱运行时镜像（仅预拉取，不部署）
OPENSANDBOX_SANDBOX_IMAGE=opensandbox/code-interpreter:v1.1.0
