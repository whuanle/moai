# ============================================
# MoAI Docker Compose 环境变量配置
# 复制为 .env 后按需修改：cp .env.example .env
#
# 本文件是 Compose 部署的**唯一配置来源**：
# deploy-compose.sh 会据此生成 configs/system.json（挂载进容器）。
# 参考模板见 configs/system.example.json。
# ============================================

# ============================================
# MoAI 服务
# ============================================
# 应用镜像（默认 Docker Hub；本地源码构建时 compose 会使用 build 结果）
MOAI_IMAGE=whuanle/moai:latest
# MoAI 容器映射到宿主机的端口；留空时独立部署默认 8080，共享 moai 网络时默认 8081
MOAI_PORT=
TZ=Asia/Shanghai

# MoAI 对外访问地址（含协议，可带端口）。写入生成的 system.json 的 Server/WebUI，
# 前端据此拼接 /static 资源地址，必须与浏览器访问地址完全一致。
# 例：https://moai.example.com（Caddy/域名）或 http://1.2.3.4:8080（裸 IP）。
# 留空时 deploy-compose.sh 自动探测本机 IP，生成 http://<IP>:${MOAI_PORT}
MOAI_SERVER_URL=

# 应用配置文件在宿主机的位置（挂载到容器 /app/configs/system.json）。
# deploy-compose.sh 会按本文件的环境变量生成该配置；可填相对仓库根或绝对路径。
MOAI_CONFIG_FILE=./configs/system.json

# ============================================
# MoAI 应用配置（deploy-compose.sh 据此生成 ${MOAI_CONFIG_FILE}）
# ============================================
# AES 加密密钥（生产务必改为随机串）
MOAI_AES_KEY=please-change-this-aes-key

# 对象存储对外访问地址（含协议，自定义域名 / 外部 OSS 时填），如 https://oss.example.com。
# 留空则用 http://<自动探测IP>:${RUSTFS_PORT}。
# 该地址会写入预签名 URL，必须同时被容器与浏览器可达。
S3_ENDPOINT=

# OpenSandbox 沙箱存活时间与续期阈值（秒）
OPENSANDBOX_TIMEOUT_SECONDS=900
OPENSANDBOX_RENEW_THRESHOLD_SECONDS=300

# OpenTelemetry（可选，留空禁用）
OTLP_TRACE=
OTLP_METRICS=
OTLP_PROTOCOL=0

# ============================================
# PostgreSQL 数据库（pgvector）
# MoAI 独立使用 POSTGRES_DB=moai；复用已有 moai 网络时会在共享 PostgreSQL 中自动创建此库。
# POSTGRES_USER / POSTGRES_PASSWORD 必须与共享 PostgreSQL 的初始化凭据一致，且账户有 CREATEDB 权限。
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mopl123456
POSTGRES_DB=moai
POSTGRES_PORT=5432

# 复用已有 moai Docker 网络时，MoAI 自动复用网络内的 PostgreSQL、Redis、RabbitMQ 和 RustFS，
# 仅启动 MoAI 自己的数据库初始化、存储桶初始化、OpenSandbox 与应用容器。
# 与其它 Mo 系列服务共用时，POSTGRES_USER/PASSWORD、RABBITMQ_USER/PASSWORD、
# S3_ACCESS_KEY_ID/SECRET 必须与最先启动的基础设施配置相同；POSTGRES_DB 和 S3_BUCKET 各自独立。
# 检测到共享网络时，MOAI_PORT 默认 8081；独立部署时默认 8080。显式填写可覆盖。

# ============================================
# Redis（写入生成的 system.json 的 MoAI:Redis）
# ============================================
REDIS_PORT=6379
# 复用模式可覆盖发现到的服务容器名；通常留空由部署脚本自动解析
MOAI_REDIS_HOST=

# ============================================
# RabbitMQ（写入生成的 system.json 的 MoAI:RabbitMQ）
# ============================================
RABBITMQ_USER=mopl
RABBITMQ_PASSWORD=mopl123456
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MOAI_RABBITMQ_HOST=

# ============================================
# RustFS 对象存储（S3 兼容，替代 MinIO）
# S3_* 会写入生成的 system.json 的 MoAI:Storage
# ============================================
RUSTFS_IMAGE=rustfs/rustfs:latest
RUSTFS_INIT_IMAGE=amazon/aws-cli:latest
S3_ACCESS_KEY_ID=mopladmin
S3_ACCESS_KEY_SECRET=mopladmin123
S3_BUCKET=moai
S3_REGION=us-east-1
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
MOAI_POSTGRES_HOST=
MOAI_RUSTFS_HOST=
# 数据库初始化工具镜像（与 pgvector PostgreSQL 版本保持一致）
POSTGRES_INIT_IMAGE=pgvector/pgvector:pg16
# 浏览器跨域直传允许的源（RustFS CORS）。生产建议填 MoAI 站点源，如 https://moai.example.com；
# 多个用逗号分隔，* 表示允许任意源（预签名直传不带 cookie，可接受）。
# ⚠️ 若 RustFS 前面的 Caddy/nginx 也加了 Access-Control-Allow-Origin，会重复（*, *）导致浏览器报错，
#    此时请把本项置空（由反代负责 CORS），二选一。
RUSTFS_CORS_ALLOWED_ORIGINS=*

# ============================================
# OpenSandbox 沙箱服务
# ============================================
# 生命周期服务镜像（官方镜像；受限网络可用阿里云镜像
# sandbox-registry.cn-zhangjiakou.cr.aliyuncs.com/opensandbox/server:release-1.1.0）
OPENSANDBOX_SERVER_IMAGE=opensandbox/server:latest
OPENSANDBOX_PORT=18123
# sandbox.toml 未配置 api_key 时必须为 YES（仅内网可信环境）
OPENSANDBOX_INSECURE_SERVER=YES
# 沙箱运行时镜像（仅预拉取，不部署）
OPENSANDBOX_SANDBOX_IMAGE=opensandbox/code-interpreter:v1.1.0
